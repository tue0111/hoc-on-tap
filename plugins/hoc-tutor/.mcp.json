{
  "mcpServers": {
    "giao-trinh-files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--read-only",
        "${CLAUDE_PROJECT_DIR}/_grok_pack"
      ]
    },
    "hoc-tra-cuu": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/tra_cuu_server.py"],
      "env": {
        "HOC_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
