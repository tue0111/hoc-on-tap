  "outline_titles": [
    {
      "source_id": "src-0554",
      "title": "Tiếp theo, tôi trình bày điều kiện ghi nhận bất động sản đầu tư.",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Bất động sản đầu tư là tài sản nên điều kiện ghi nhận BĐS đầu tư cũng tương tự như điều kiện ghi nhận của tài sản. Do vậy, một bất động sản đầu tư được ghi nhận là tài sản phải thỏa mãn đồng thời hai điều kiện sau:",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Chắc chắn thu được lợi ích kinh tế trong tương lai; và",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Nguyên giá của bất động sản đầu tư phải được xác định một cách đáng tin cậy.",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Chúng ta cùng nhau phân tích ví dụ sau: DN mua một cửa hàng nhằm mục đích cho thuê, giá trị ghi trên chứng từ mua bán là 12 tỷ đồng.",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Yêu cầu: Bất động sản trên có đủ điều kiện ghi nhận là bất động sản đầu tư hay không?",
      "page": 4
    },
    {
      "source_id": "src-0554",
      "title": "Giải đáp:",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Trường hợp mua bất động sản: nguyên giá của bất động sản đầu tư được mua bao gồm giá mua và các chi phí liên quan trực tiếp, như: phí dịch vụ tư vấn về luật pháp liên quan, thuế trước bạ và chi phí giao dịch liên quan khác...",
      "page": 1
    },
    {
      "source_id": "src-0555",
      "title": "Giải đáp:",
      "page": 1
    },
    {
      "source_id": "src-0555",
      "title": "Lô đất do DN mua lại nhằm mục đích để chờ tăng giá nên lô đất này được ghi nhận là bất động sản đầu tư.",
      "page": 1
    },
    {
      "source_id": "src-0555",
      "title": "Nguyên giá được xác định như sau: 9.000 + 50 + 100 + 20 = 9.170 triệu đồng.",
      "page": 1
    },
    {
      "source_id": "src-0555",
      "title": "Trường hợp xây dựng bất động sản. Nguyên giá của bất động sản đầu tư tự xây dựng là giá thành thực tế và các chi phí liên quan trực tiếp của bất động sản đầu tư tính đến ngày hoàn thành công việc xây dựng. Từ khi bắt đầu xây dựng cho đến ngày hoàn thành công việc xây dựng doanh nghiệp áp dụng chuẩn mực kế toán số 03 “Tài sản cố định hữu hình” và chuẩn mực kế toán số 04 “Tài sản cố định vô hình”. Tại ngày tài sản trở thành bất động sản đầu tư thì áp dụng chuẩn mực bất động sản đầu tư. Với quy định trên thì chúng ta lưu ý rằng chi phí lãi vay sẽ được vốn hóa vào giá trị bất động sản đầu tư, nghĩa là chi phí lãi vay liên quan đến bất động sản đầu tư trong giai đoạn xây dựng được tính và nguyên giá bất động sản đầu tư. Các trường hợp cụ thể về xử lý chi phí đi vay chúng ta xem ở chuẩn mực kế toán chi phí đi vay và tài sản cố định hữu hình.",
      "page": 2
    },
    {
      "source_id": "src-0555",
      "title": "Chi phí phát sinh sau ghi nhận ban đầu, sau khi BĐS đã đi vào sử dụng để cho thuê hoặc chờ tăng giá. Chi phí phát sinh trong thời gian này sẽ được ghi nhận như thế nào? Có được ghi vào nguyên giá không? Việc có ghi chi phí này vào nguyên giá hay không phụ thuộc vào khả năng có làm gia tăng lợi ích kinh tế trong tương lai hay không.",
      "page": 3
    },
    {
      "source_id": "src-0555",
      "title": "Theo quy định của chuẩn mực kế toán BĐS đầu tư: “Chi phí liên quan đến bất động sản đầu tư phát sinh sau ghi nhận ban đầu phải được ghi nhận là chi phí sản xuất, kinh doanh trong kỳ, trừ khi chi phí này có khả năng chắc chắn làm cho bất động sản đầu tư tạo ra lợi ích kinh tế trong tương lai nhiều hơn mức hoạt động được đánh giá ban đầu thì được ghi tăng nguyên giá bất động sản đầu tư”.",
      "page": 3
    },
    {
      "source_id": "src-0555",
      "title": "Giải đáp:",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Giải đáp",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Bất động sản xây dựng chuyển thành bất động sản đầu tư.",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Bất động sản đầu tư chuyển thành bất động sản chủ sở hữu sử dụng.",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Bất động sản đầu tư chuyển thành hàng tồn kho.",
      "page": 4
    },
    {
      "source_id": "src-0555",
      "title": "Bất động sản chủ sở hữu sử dụng chuyển thành bất động sản đầu tư.",
      "page": 5
    },
    {
      "source_id": "src-0555",
      "title": "Chi phí sản xuất kinh doanh dở dang chuyển thành thành phẩm bất động sản.",
      "page": 5
    }
